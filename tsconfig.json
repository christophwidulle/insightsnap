{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["chrome", "vite/client"]
  },
  // test/ is deliberately excluded: it runs under `node --test`, which needs Node globals
  // and .ts import extensions that the browser build must not allow. Running the tests
  // verifies them more thoroughly than tsc would.
  "include": ["src", "vite.config.ts", "manifest.config.ts"]
}
